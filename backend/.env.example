# ============================================
# SLABDASH - ENVIRONMENT CONFIG
# ============================================

NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/slabdash

# JWT
JWT_SECRET=change-this-to-a-random-64-character-string-in-production
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# PSA API
PSA_API_BASE=https://api.psacard.com/publicapi

# Price Comp Lookup APIs
# eBay Finding API for sold listings (optional - comp lookups will skip if not configured)
# Get your eBay App ID at: https://developer.ebay.com/
EBAY_APP_ID=your-ebay-app-id-here

# TCGPlayer API for trading cards (optional - coming soon)
# Get your API key at: https://www.tcgplayer.com/
TCGPLAYER_API_KEY=your-tcgplayer-api-key-here

# Default Email Service (for companies not using custom SMTP)
# These settings are used when use_custom_smtp is false
# Uses Mailgun HTTP API (works on Railway, no SMTP ports needed)
DEFAULT_MAILGUN_API_KEY=your-mailgun-api-key-here
DEFAULT_MAILGUN_DOMAIN=slabdash.app
DEFAULT_FROM_EMAIL=slabdashllc@slabdash.app
DEFAULT_FROM_NAME=SlabDash

# Push Notifications (Web Push VAPID Keys)
# Generate keys using: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_SUBJECT=mailto:support@slabdash.app
