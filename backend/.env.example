# ============================================
# SLABDASH - ENVIRONMENT CONFIG
# ============================================

NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/slabdash

# JWT
JWT_SECRET=change-this-to-a-random-64-character-string-in-production
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# PSA API
PSA_API_BASE=https://api.psacard.com/publicapi

# Price Comp Lookup APIs
# eBay Browse API for card pricing (optional - comp lookups will skip if not configured)
# Get your credentials at: https://developer.ebay.com/my/keys
# App ID (Client ID) and Cert ID (Client Secret) are both required
EBAY_APP_ID=your-ebay-client-id-here
EBAY_CERT_ID=your-ebay-client-secret-here

# TCGPlayer API for trading cards (optional - coming soon)
# Get your API key at: https://www.tcgplayer.com/
TCGPLAYER_API_KEY=your-tcgplayer-api-key-here

# Card Scanner OCR
# Google Cloud Vision API for card scanning (optional - scanner will show error if not configured)
# Get your service account credentials at: https://console.cloud.google.com/iam-admin/serviceaccounts
# Enable the Cloud Vision API in your Google Cloud project
# Download the JSON credentials file and paste the entire JSON object as a string here
GOOGLE_CLOUD_CREDENTIALS={"type":"service_account","project_id":"your-project","private_key":"-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n","client_email":"your-service-account@your-project.iam.gserviceaccount.com"}

# SAM (Submission Assistant Manager) AI
# Anthropic Claude API for AI-powered chat assistant (optional - falls back to rule-based responses)
# Get your API key at: https://console.anthropic.com/settings/keys
# Recommended model: claude-sonnet-4-5-20250929
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Default Email Service (for companies not using custom SMTP)
# These settings are used when use_custom_smtp is false
# Uses Mailgun HTTP API (works on Railway, no SMTP ports needed)
DEFAULT_MAILGUN_API_KEY=your-mailgun-api-key-here
DEFAULT_MAILGUN_DOMAIN=slabdash.app
DEFAULT_FROM_EMAIL=slabdashllc@slabdash.app
DEFAULT_FROM_NAME=SlabDash

# Push Notifications (Web Push VAPID Keys)
# Generate keys using: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_SUBJECT=mailto:support@slabdash.app

# Stripe Payment Processing (required for subscriptions)
# Get your keys at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# Stripe Price IDs for subscription plans
# Create products in Stripe dashboard and paste the price IDs here
STRIPE_PRICE_STARTER=price_your-starter-price-id
STRIPE_PRICE_PRO=price_your-pro-price-id
STRIPE_PRICE_ENTERPRISE=price_your-enterprise-price-id

# Owner Setup Secret
# Used for initial owner account setup - keep this secret!
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OWNER_SETUP_SECRET=your-64-character-random-string-here
